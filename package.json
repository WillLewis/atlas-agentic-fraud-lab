{
  "name": "atlas-agentic-fraud-lab",
  "private": true,
  "version": "0.0.1",
  "description": "Project Atlas — synthetic red/blue fraud-model evaluation arena. Local-only, defensive, public-safe.",
  "workspaces": [
    "app/web"
  ],
  "scripts": {
    "dev": "npm --workspace app/web run dev",
    "build": "npm --workspace app/web run build",
    "build:atlas": "ATLAS_DEPLOY_TARGET=cloudflare ATLAS_PUBLIC_BASE_PATH=/atlas npm --workspace app/web run build",
    "preview:atlas": "wrangler dev --config wrangler.atlas.jsonc --local --port 8787",
    "deploy:atlas": "wrangler deploy --config wrangler.atlas.jsonc",
    "start": "npm --workspace app/web run start",
    "lint": "npm --workspace app/web run lint",
    "typecheck": "npm --workspace app/web run typecheck"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "^8.5.12"
  },
  "devDependencies": {
    "wrangler": "^4.95.0"
  }
}
