# --- Generated synthetic data and run outputs ---
# outputs/ is generated. Only curated public-safe replays under outputs/demo_replays/
# may be committed by hand after passing safety scan.
outputs/runs/
outputs/ledgers/
outputs/model_vulnerabilities/
outputs/defensive_fixes/
outputs/reports/
outputs/baseline_models/
outputs/demo_replays/*
