# --- Synthetic data caches ---
data/synthetic/*
!data/synthetic/.gitkeep
data/fixtures/*.generated.json

# --- Logs ---
*.log
logs/

# --- Jupyter ---
.ipynb_checkpoints/
*.ipynb

# --- Local sandbox notes (must not be committed) ---
scratch/
notes.local.md

